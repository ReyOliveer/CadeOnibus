{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "MobilidadeRio": {
    "BaseUrl": "https://dados.mobilidade.rio",
    "JanelaTempoMinutos": 2,
    "CacheSegundos": 60,
    "TimeoutSegundos": 60,
    "MaxRetries": 3,
    "MinutosMaximosParado": 10
  },
  "RateLimit": {
    "MaxRequests": 30,
    "JanelaSegundos": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}
